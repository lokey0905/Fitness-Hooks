<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="AlwaysShowAction">
    <!-- Keep both requested toolbar actions directly visible, including on compact screens. -->
    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings_outline"
        android:title="@string/app_settings_title"
        app:contentDescription="@string/app_settings_title"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        app:tooltipText="@string/app_settings_title" />
    <item
        android:id="@+id/action_about"
        android:icon="@drawable/ic_info_outline"
        android:title="@string/about_title"
        app:contentDescription="@string/about_title"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        app:tooltipText="@string/about_title" />
</menu>
